pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Install Dependencies') {
            steps {
                sh 'npm install'
            }
        }

        stage('Test') {
            steps {
                sh 'npm test'
            }
        }

        stage('Docker Build') {
            steps {
                sh 'docker build -t orderflow:latest .'
            }
        }

	stage('Docker Run') {
            steps {
                sh 'docker stop orderflow-app || true'
                sh 'docker rm orderflow-app || true'
                sh 'docker run -d -p 3000:3000 --name orderflow-app orderflow:latest'
    }
}

    }
}